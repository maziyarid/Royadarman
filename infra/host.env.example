# Documented Royadarman host layout.
# Copy values to the operator runbook, not to production .env.
# Secrets MUST remain in the host .env only (never committed).
#
# Source: backend/ARCHITECTURE.md + backend/DEPLOYMENT.md
# These are documented defaults, not live-verified this hour.

# PHP 8.3 — Laravel 13. Bare `php` on this host may be 8.2 and must not be used.
# static-guard parses PHP_BIN and requires systemd/cron/deploy.md/DEPLOYMENT.md
# to use this exact path. Do not hard-code a second binary.
PHP_BIN=/usr/local/bin/ea-php83

# Application checkout / artefact root (not the public vhost).
APP_DIR=/home/royadarman/apps/royadarman-backend

# Apache public root: front controller + public assets only.
PUBLIC_ROOT=/home/royadarman/public_html

# cPanel account that owns the app, cron, and (typically) the queue unit.
APP_USER=royadarman
APP_GROUP=royadarman

# Private OPG disks — outside public_html, mode 0750, not HTTP-reachable.
# Production may bind these to /home/royadarman/private_uploads/{quarantine,approved}.
OPG_QUARANTINE_ROOT=/home/royadarman/private_uploads/quarantine
OPG_APPROVED_ROOT=/home/royadarman/private_uploads/approved

# ClamAV CLI used by ClamAvDocumentScanner (must be executable).
# static-guard parses CLAMSCAN and requires royadarman.php default,
# backend/.env.example, and clamav.md to lockstep. Does not inspect the host.
CLAMSCAN=/usr/bin/clamscan

# Queue: Laravel database driver. Workers must not be QUEUE_CONNECTION=sync in production.
QUEUE_CONNECTION=database
QUEUE_NAMES=otp,scanning,notifications,maintenance
# Lockstep with infra/queue-timing.conf. A live DB_QUEUE_RETRY_AFTER override
# that sits at or below ROYADARMAN_QUEUE_WORKER_TIMEOUT is a double-claim hazard.
DB_QUEUE_RETRY_AFTER=90
ROYADARMAN_QUEUE_WORKER_TIMEOUT=85

# Scheduler timezone for operator clocks; Laravel schedule uses the app timezone.
DISPLAY_TIMEZONE=Asia/Tehran

# Release provenance when deploying an artefact without a .git directory.
# Set on the host to the exact SHA being released, then:
#   "$PHP_BIN" artisan royadarman:release-identity --write
# ROYADARMAN_RELEASE_COMMIT=<40-char-sha>

# Never commit the following. They belong only on the host:
# APP_KEY
# ROYADARMAN_PHONE_HASH_KEY
# DB_PASSWORD
# TSMS_USERNAME / TSMS_PASSWORD / TSMS_FROM
# ROYADARMAN_SMS_CALLBACK_SECRET
