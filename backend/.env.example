APP_NAME=Royadarman
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

INTAKE_ENABLED=false
# REQUIRED before application use:
# Generate a unique secret with: php -r "echo bin2hex(random_bytes(32));"
# This MUST be a non-empty high-entropy secret, independent of APP_KEY. There is
# intentionally no active default here: a missing/empty/too-short value fails
# closed — `royadarman:preflight` reports it and `PhoneHasher` throws at
# resolution time, so no empty-key HMAC is ever executed. Treat rotation as a
# data migration: rehashing changes all phone lookup hashes.
# ROYADARMAN_PHONE_HASH_KEY=<unique-64-hex-secret>
ROYADARMAN_OPG_DISK=private-opg
ROYADARMAN_OPG_QUARANTINE_DISK=opg-quarantine
ROYADARMAN_OPG_ROOT=storage/app/private/opg
ROYADARMAN_OPG_QUARANTINE_ROOT=storage/app/private/opg-quarantine
ROYADARMAN_OPG_MAX_KB=20480
ROYADARMAN_OPG_MAX_PIXELS=60000000
ROYADARMAN_OPG_SCANNER_ENABLED=false
ROYADARMAN_OPG_SCANNER_COMMAND=/usr/bin/clamscan
ROYADARMAN_OPG_SCANNER_TIMEOUT=60

ROYADARMAN_CMS_ROOT=storage/app/public/cms

# SMS provider. Production is TSMS, matching the Medical CRM integration.
ROYADARMAN_SMS_PROVIDER=tsms
TSMS_API_URL=https://tsms.ir/url/tsmshttp.php
TSMS_USERNAME=
TSMS_PASSWORD=
TSMS_FROM=
# The current TSMS URL API integration is send-only; keep callbacks disabled.
ROYADARMAN_SMS_CALLBACKS_ENABLED=false
ROYADARMAN_SMS_CALLBACK_SECRET=
# Generic HTTP provider fallback (used only when ROYADARMAN_SMS_PROVIDER=http).
ROYADARMAN_SMS_ENDPOINT=
ROYADARMAN_SMS_TOKEN=

# Referral grant lifetime in minutes. Must be a positive integer before intake
# is enabled (preflight fails otherwise). Leave unset until an approved
# duration is chosen. Do not assign an empty value (`=`) — env() reads that
# as "" rather than null.
# ROYADARMAN_REFERRAL_GRANT_TTL_MINUTES=43200
# Unanswered-proposal SLA (minutes) for coordinator expiry / silent-loss surfacing.
# Default is 1440 when unset. This is not an intake gate.
# ROYADARMAN_REFERRAL_PROPOSAL_SLA_MINUTES=1440
# Release traceability: set ROYADARMAN_RELEASE_COMMIT to the deployed Git SHA
# when deploying from artefacts (no working tree). The release-identity command
# falls back to the working-tree HEAD when this is unset.
ROYADARMAN_RELEASE_COMMIT=
# ROYADARMAN_DOCUMENT_RETENTION_DAYS must stay unset until an operator-approved
# retention period is approved. Leaving it unset keeps retention fail-closed.
# Do not assign an empty value (`=`) — env() reads that as "" rather than null.
# ROYADARMAN_DOCUMENT_RETENTION_DAYS=365

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_EXCEPTIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Set SESSION_ENCRYPT=true in production (preflight enforces it).

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Reservation window must stay SAFETY_MARGIN seconds above worker timeout.
# Lockstep with infra/queue-timing.conf. Live overrides are fail-closed by preflight.
DB_QUEUE_RETRY_AFTER=90
ROYADARMAN_QUEUE_WORKER_TIMEOUT=85
CACHE_STORE=database

MAIL_MAILER=log

# Temporary signed role-panel testing. Keep false outside controlled QA windows.
PANEL_DEMO_ACCESS=false

# Neshan MapLibre web SDK key (client-side, domain-restrict in the Neshan panel).
# Empty = the referrals map canvas is hidden; the clinic list and directions links still work.
# Never commit a live key. Do not put a Direction/service API key here.
NESHAN_MAP_API_KEY=
