APP_NAME=Royadarman
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://royadarman.com

# Intake kill-switch: must be false until all activation gates pass.
INTAKE_ENABLED=false

# Database (MariaDB 10.11 in production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=royadarman
DB_USERNAME=
DB_PASSWORD=

# Queue (database-backed in production)
QUEUE_CONNECTION=database

# Cache / Session
CACHE_STORE=database
SESSION_DRIVER=database

# Filesystem
FILESYSTEM_DISK=local

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Royadarman — OPG document pipeline
ROYADARMAN_OPG_ROOT=storage/app/private/opg
ROYADARMAN_OPG_QUARANTINE_ROOT=storage/app/private/opg-quarantine
ROYADARMAN_OPG_DISK=private-opg
ROYADARMAN_OPG_QUARANTINE_DISK=opg-quarantine
ROYADARMAN_OPG_MAX_KB=20480
ROYADARMAN_OPG_MAX_PIXELS=60000000

# Royadarman — ClamAV scanner (fails closed when disabled/unavailable)
ROYADARMAN_OPG_SCANNER_ENABLED=false
ROYADARMAN_OPG_SCANNER_COMMAND=/usr/bin/clamscan
ROYADARMAN_OPG_SCANNER_TIMEOUT=60

# Royadarman — CMS media storage (separate from OPG clinical files)
ROYADARMAN_CMS_ROOT=storage/app/public/cms

# Royadarman — phone hash key (use a separate secret in production)
ROYADARMAN_PHONE_HASH_KEY=

# Royadarman — SMS provider (BLOCKED_EXTERNAL until credentials provided)
ROYADARMAN_SMS_PROVIDER=http
ROYADARMAN_SMS_ENDPOINT=
ROYADARMAN_SMS_TOKEN=
ROYADARMAN_SMS_CALLBACK_SECRET=

# Royadarman — document retention (days); empty = not yet configured
ROYADARMAN_DOCUMENT_RETENTION_DAYS=
